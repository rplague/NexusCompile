#!/bin/sh
set -e

. /usr/share/debconf/confmodule

PKG="@PKG@"
USER_NAME="@USER@"
STATE="/var/lib/${PKG}/cargo-users"
TOOLCHAIN_STATE="/var/lib/${PKG}/toolchain-selection"
MARKER="/var/lib/${PKG}/onboarding-in-progress"
VERSION="@VERSION@"

db_version 2.0 || true

db_seen() {
    db_fget "$1" seen || true
    [ "${RET:-false}" = "true" ]
}

human_users() {
    getent passwd 2>/dev/null | awk -F: '
        $3 >= 1000 && $3 < 60000 && $7 !~ /(nologin|false)$/ { print $1 }
    ' | sort -u
}

group_members() {
    getent group "${USER_NAME}" 2>/dev/null \
        | cut -d: -f4 \
        | tr ',' '\n' \
        | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
        | sed '/^$/d'
}

filter_known() {
    _known=" $1 "
    _input="$2"
    _out=""
    _oldifs="$IFS"
    IFS=', '
    for _item in $_input; do
        if echo "$_known" | grep -q " $_item "; then
            if [ -z "$_out" ]; then
                _out="$_item"
            else
                _out="$_out, $_item"
            fi
        fi
    done
    IFS="$_oldifs"
    printf '%s' "$_out"
}

USERS_LIST="$(human_users)"
USERS_SPACE="$(printf '%s\n' "${USERS_LIST}" | tr '\n' ' ')"
USERS_CSV="$(printf '%s\n' "${USERS_LIST}" | tr '\n' ',' | sed 's/,$//; s/,/, /g')"

if [ -f "${STATE}" ]; then
    INITIAL="$(cat "${STATE}" 2>/dev/null || true)"
else
    INITIAL="$(group_members | tr '\n' ',' | sed 's/,$//')"
fi
INITIAL="$(filter_known "${USERS_SPACE}" "${INITIAL}")"

DEFAULT_CHANNEL=stable
if [ -f "${TOOLCHAIN_STATE}" ]; then
    _saved_channel="$(sed -n 's/^channel=//p' "${TOOLCHAIN_STATE}" | head -n 1)"
    if [ -n "${_saved_channel}" ]; then
        DEFAULT_CHANNEL="${_saved_channel}"
    fi
fi

if [ "${DEBIAN_FRONTEND:-}" = "noninteractive" ]; then
    db_get "@PKG@/cargo_users" || true
    if [ -z "${RET:-}" ] && [ -f "${STATE}" ]; then
        db_set "@PKG@/cargo_users" "$(cat "${STATE}" 2>/dev/null || true)"
    fi

    db_get "@PKG@/rust_toolchain" || true
    if [ -z "${RET:-}" ]; then
        db_set "@PKG@/rust_toolchain" "${DEFAULT_CHANNEL}"
    fi
    db_stop 2>/dev/null || true
    exit 0
fi

# dpkg may invoke this config script more than once in a single run before
# postinst completes. Keep the first set of answers instead of asking again.
if [ "${DEBCONF_RECONFIGURE:-}" != "1" ] \
    && [ -f "${MARKER}" ] \
    && [ "$(cat "${MARKER}" 2>/dev/null)" = "${VERSION}" ] \
    && db_seen "@PKG@/cargo_users" \
    && db_seen "@PKG@/rust_toolchain"; then
    db_stop 2>/dev/null || true
    exit 0
fi

rm -f "${MARKER}"

if [ -n "${USERS_LIST}" ]; then
    db_subst "@PKG@/cargo_users" USERS "${USERS_CSV}"
    db_set "@PKG@/cargo_users" "${INITIAL}"
    db_input high "@PKG@/cargo_users" || true
    if db_go; then
        db_fset "@PKG@/cargo_users" seen true || true
    fi
else
    db_set "@PKG@/cargo_users" ""
    db_fset "@PKG@/cargo_users" seen true || true
fi

db_get "@PKG@/rust_toolchain" || true
if [ -z "${RET:-}" ]; then
    db_set "@PKG@/rust_toolchain" "${DEFAULT_CHANNEL}"
fi
db_input high "@PKG@/rust_toolchain" || true
if db_go; then
    db_fset "@PKG@/rust_toolchain" seen true || true
fi

mkdir -p "$(dirname "${MARKER}")"
printf '%s\n' "${VERSION}" > "${MARKER}"
chmod 0600 "${MARKER}" 2>/dev/null || true
db_stop 2>/dev/null || true
