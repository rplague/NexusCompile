#!/bin/sh
# @BIN@ deb package postrm (after removal)
# Arguments:
#   remove       normal removal
#   upgrade      upgrade
#   purge        full purge (dpkg -P)
# Note: runtime data under /var/lib/@PKG@ is not removed, and the @USER@ account is not removed.
#       Logs are managed by journald and handled elsewhere.
set -e

UNIT_NAME="@PKG@"
MARKER="/var/lib/@PKG@/onboarding-in-progress"

case "$1" in
    remove|purge)
        rm -f "${MARKER}"
        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
    upgrade|abort-install|abort-upgrade|disappear)
        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
esac

exit 0
