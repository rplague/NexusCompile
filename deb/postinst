#!/bin/sh
# @BIN@ deb package postinst
# Arguments:
#   $1=configure     install or upgrade
#   $2=old version   empty on first install, replaced version on upgrade
set -e

. /usr/share/debconf/confmodule

USER_NAME="@USER@"
UNIT_NAME="@PKG@"
BIN_NAME="@BIN@"
PKG="@PKG@"
DATA_DIR="/var/lib/${PKG}"
CACHE_DIR="${DATA_DIR}/cache"
STATE="${DATA_DIR}/cargo-users"
TOOLCHAIN_STATE="${DATA_DIR}/toolchain-selection"
TOOLCHAIN_ROOT="${DATA_DIR}/toolchains"
TOOLCHAIN_REGISTRY="${TOOLCHAIN_ROOT}/rust/state"
TOOLCHAIN_HELPER="/usr/lib/${PKG}/install-toolchain"
TOOLCHAIN_CONFIG="/etc/${PKG}/config.toml"
CONFIG_SCHEMA_FILE="/etc/${PKG}/config.schema"
CURRENT_SCHEMA=@CONFIG_SCHEMA@
BREAKING_BELOW=@BREAKING_BELOW@
MARKER="${DATA_DIR}/onboarding-in-progress"
SOCKET="/run/${PKG}/nexus.sock"
CARGO_BIN="/usr/bin/${BIN_NAME}"
RUNUSER_BIN="$(command -v runuser 2>/dev/null || true)"
[ -n "${RUNUSER_BIN}" ] || RUNUSER_BIN=/usr/sbin/runuser

create_system_user() {
    if ! getent group "${USER_NAME}" >/dev/null 2>&1; then
        groupadd --system "${USER_NAME}" 2>/dev/null || true
    fi
    if id "${USER_NAME}" >/dev/null 2>&1; then
        return 0
    fi
    if command -v useradd >/dev/null 2>&1; then
        if getent group "${USER_NAME}" >/dev/null 2>&1; then
            useradd --system --gid "${USER_NAME}" --no-create-home --shell /usr/sbin/nologin "${USER_NAME}" || true
        else
            useradd --system --user-group --no-create-home --shell /usr/sbin/nologin "${USER_NAME}" || true
        fi
    fi
}

create_dirs() {
    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create /usr/lib/tmpfiles.d/@PKG@.conf >/dev/null 2>&1 || true
    else
        mkdir -p "/etc/${PKG}" "${DATA_DIR}"
        chown "${USER_NAME}:${USER_NAME}" "/etc/${PKG}" "${DATA_DIR}" || true
        chmod 0755 "/etc/${PKG}"; chmod 0700 "${DATA_DIR}"
    fi
}

ensure_persistent_journal() {
    if [ ! -d /var/log/journal ]; then
        mkdir -p /var/log/journal 2>/dev/null || return 0
        chown root:systemd-journal /var/log/journal 2>/dev/null || true
        chmod 2755 /var/log/journal 2>/dev/null || true
        systemctl restart systemd-journald >/dev/null 2>&1 || true
    fi
}

read_installed_schema() {
    if [ ! -f "${CONFIG_SCHEMA_FILE}" ]; then
        printf '0'
        return 0
    fi
    _value="$(cat "${CONFIG_SCHEMA_FILE}" 2>/dev/null || printf '0')"
    case "${_value}" in
        ''|*[!0-9]*) printf '0' ;;
        *) printf '%s' "${_value}" ;;
    esac
}

write_installed_schema() {
    printf '%s\n' "$1" > "${CONFIG_SCHEMA_FILE}" || return 1
    chown "${USER_NAME}":"${USER_NAME}" "${CONFIG_SCHEMA_FILE}" 2>/dev/null || true
    chmod 0644 "${CONFIG_SCHEMA_FILE}" 2>/dev/null || true
}

config_fail() {
    _message="$1"
    echo "NexusCompile: ${_message}" >&2
    db_subst "@PKG@/config_error" ERROR "${_message}" || true
    db_input critical "@PKG@/config_error" || true
    db_go || true
    db_stop 2>/dev/null || true
    systemctl disable --now "${UNIT_NAME}" >/dev/null 2>&1 || true
    exit 1
}

ensure_config() {
    if [ -f "${TOOLCHAIN_CONFIG}" ]; then
        return 0
    fi
    "${CARGO_BIN}" config-defaults --config "${TOOLCHAIN_CONFIG}"
}

ensure_schema() {
    _installed="$(read_installed_schema)"
    if [ "${_installed}" -lt "${BREAKING_BELOW}" ]; then
        config_fail "现有配置 schema ${_installed} 低于最低兼容版本 ${BREAKING_BELOW}；请运行 dpkg-reconfigure ${PKG} 后重试。"
    fi
    if [ "${_installed}" -gt "${CURRENT_SCHEMA}" ]; then
        config_fail "现有配置 schema ${_installed} 高于当前程序支持的 ${CURRENT_SCHEMA}；请升级 NexusCompile。"
    fi
    if ! "${CARGO_BIN}" config-check --config "${TOOLCHAIN_CONFIG}"; then
        config_fail "配置检查失败：${TOOLCHAIN_CONFIG}；请修复后运行 sudo dpkg --configure -a。"
    fi
    write_installed_schema "${CURRENT_SCHEMA}" || config_fail "写入 ${CONFIG_SCHEMA_FILE} 失败。"
}

normalized_users() {
    printf '%s' "$1" | tr ',' '\n' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' | sed '/^$/d'
}

user_home() {
    getent passwd "$1" 2>/dev/null | cut -d: -f6
}

user_uid() {
    getent passwd "$1" 2>/dev/null | cut -d: -f3
}

user_group() {
    id -gn "$1" 2>/dev/null
}

manageable_user() {
    _user="$1"
    _uid="$(user_uid "${_user}")"
    _home="$(user_home "${_user}")"
    [ -n "${_uid}" ] || return 1
    [ "${_uid}" -ge 1000 ] 2>/dev/null || return 1
    [ "${_uid}" -lt 60000 ] 2>/dev/null || return 1
    [ -n "${_home}" ] || return 1
    [ -d "${_home}" ] || return 1
    return 0
}

clear_cargo_for() {
    _user="$1"
    manageable_user "${_user}" || return 0
    _home="$(user_home "${_user}")"
    _group="$(user_group "${_user}")"
    _config="${_home}/.cargo/config.toml"
    if [ ! -f "${_config}" ]; then
        return 0
    fi
    if [ -x "${CARGO_BIN}" ]; then
        "${CARGO_BIN}" unsetup-user --config "${_config}" >/dev/null 2>&1 || true
        chown "${_user}:${_group}" "${_config}" "${_config}.nexuscompile.bak" 2>/dev/null || true
        chmod 0644 "${_config}" 2>/dev/null || true
    fi
}

setup_cargo_for() {
    _user="$1"
    manageable_user "${_user}" || {
        echo "NexusCompile: 跳过用户 ${_user}（不是普通用户或 home 不存在）" >&2
        return 0
    }

    _home="$(user_home "${_user}")"
    _group="$(user_group "${_user}")"
    _config="${_home}/.cargo/config.toml"

    usermod -aG "${USER_NAME}" "${_user}" 2>/dev/null || {
        echo "NexusCompile: 无法把 ${_user} 加入 ${USER_NAME} 组" >&2
        return 0
    }

    install -d -m 0755 -o "${_user}" -g "${_group}" "${_home}/.cargo" 2>/dev/null || true
    chown "${_user}:${_group}" "${_home}/.cargo" 2>/dev/null || true

    if [ ! -x "${CARGO_BIN}" ]; then
        echo "NexusCompile: 找不到 ${CARGO_BIN}，跳过 ${_user} 的 Cargo 设置" >&2
        return 0
    fi

    if "${CARGO_BIN}" setup-user --config "${_config}" --socket "${SOCKET}" >/dev/null 2>&1; then
        chown "${_user}:${_group}" "${_config}" "${_config}.nexuscompile.bak" 2>/dev/null || true
        chmod 0644 "${_config}" 2>/dev/null || true
    else
        echo "NexusCompile: 写入 ${_user} 的 Cargo 设置失败" >&2
    fi
}

install_toolchain() {
    _channel="$1"
    [ -n "${_channel}" ] || _channel=stable
    case "${_channel}" in
        *[!A-Za-z0-9._-]*)
            echo "NexusCompile: 非法 Rust 版本: ${_channel}" >&2
            return 1
            ;;
    esac

    if [ ! -x "${TOOLCHAIN_HELPER}" ]; then
        echo "NexusCompile: 缺少工具链安装脚本 ${TOOLCHAIN_HELPER}" >&2
        return 1
    fi
    if [ ! -x "${RUNUSER_BIN}" ]; then
        echo "NexusCompile: 找不到 runuser" >&2
        return 1
    fi

    install -d -m 0700 -o "${USER_NAME}" -g "${USER_NAME}" "${TOOLCHAIN_ROOT}"
    "${TOOLCHAIN_HELPER}" --user "${USER_NAME}" --root "${TOOLCHAIN_ROOT}" --channel "${_channel}" || {
        echo "NexusCompile: Rust 工具链下载或安装失败" >&2
        return 1
    }

    if ! "${CARGO_BIN}" configure-toolchains --config "${TOOLCHAIN_CONFIG}" --state "${TOOLCHAIN_REGISTRY}" >/dev/null; then
        echo "NexusCompile: 写入 ${TOOLCHAIN_CONFIG} 失败" >&2
        return 1
    fi
    chown "${USER_NAME}:${USER_NAME}" "${TOOLCHAIN_CONFIG}" 2>/dev/null || true
    chmod 0644 "${TOOLCHAIN_CONFIG}" 2>/dev/null || true

    mkdir -p "$(dirname "${TOOLCHAIN_STATE}")"
    printf 'channel=%s\ntarget=\n' "${_channel}" > "${TOOLCHAIN_STATE}"
    chown "${USER_NAME}:${USER_NAME}" "${TOOLCHAIN_STATE}" 2>/dev/null || true
    chmod 0644 "${TOOLCHAIN_STATE}" 2>/dev/null || true

    (
        cd "${DATA_DIR}" || exit 1
        "${RUNUSER_BIN}" -u "${USER_NAME}" -- env \
            NEXUSCOMPILE_HOME="${DATA_DIR}" \
            NEXUSCOMPILE_CONFIG="${TOOLCHAIN_CONFIG}" \
            NEXUSCOMPILE_CACHE="${CACHE_DIR}" \
            NEXUSCOMPILE_SOCKET="${SOCKET}" \
            "${CARGO_BIN}" doctor --skip-socket
    ) || {
        echo "NexusCompile: Rust 工具链自检失败" >&2
        return 1
    }
}

save_state() {
    _value="$1"
    mkdir -p "$(dirname "${STATE}")"
    printf '%s\n' "${_value}" > "${STATE}"
    chown "${USER_NAME}:${USER_NAME}" "${STATE}" 2>/dev/null || true
    chmod 0644 "${STATE}" 2>/dev/null || true
}

case "$1" in
    configure)
        create_system_user
        create_dirs
        ensure_persistent_journal

        db_get "@PKG@/cargo_users" || true
        SELECTED_RAW="${RET:-}"
        SELECTED="$(normalized_users "${SELECTED_RAW}" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"

        if [ "${DEBIAN_FRONTEND:-}" = "noninteractive" ] && [ -z "${SELECTED}" ] && [ -f "${STATE}" ]; then
            SELECTED="$(cat "${STATE}" 2>/dev/null || true)"
        fi

        db_get "@PKG@/rust_toolchain" || true
        TOOLCHAIN_CHANNEL="${RET:-stable}"
        TOOLCHAIN_CHANNEL="$(printf '%s' "${TOOLCHAIN_CHANNEL}" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
        [ -n "${TOOLCHAIN_CHANNEL}" ] || TOOLCHAIN_CHANNEL=stable

        if ! ensure_config; then
            config_fail "无法创建默认配置 ${TOOLCHAIN_CONFIG}；请检查 ${CARGO_BIN} 是否可用。"
        fi
        ensure_schema

        db_stop 2>/dev/null || true

        if ! install_toolchain "${TOOLCHAIN_CHANNEL}"; then
            rm -f "${MARKER}"
            echo "NexusCompile: 工具链安装失败；修复后运行 sudo dpkg --configure -a" >&2
            exit 1
        fi

        # User-level onboarding must not leave the package half-configured.
        set +e

        # Always rebuild from a clean state so repeated installs cannot duplicate
        # managed Cargo keys. Group membership is deliberately never removed.
        if [ -f "${STATE}" ]; then
            for old_user in $(normalized_users "$(cat "${STATE}" 2>/dev/null || true)"); do
                clear_cargo_for "${old_user}"
            done
        fi

        if [ -n "${SELECTED}" ]; then
            for user in ${SELECTED}; do
                setup_cargo_for "${user}"
            done
        fi
        save_state "${SELECTED}" || \
            echo "NexusCompile: 写入 ${STATE} 失败" >&2
        set -e

        if [ -n "${SELECTED}" ]; then
            echo "NexusCompile: 已启用用户: ${SELECTED}" >&2
            echo "NexusCompile: 组权限需要重新登录或执行 newgrp ${USER_NAME} 后生效" >&2
        fi

        systemctl daemon-reload >/dev/null 2>&1 || true
        systemctl enable "${UNIT_NAME}" >/dev/null 2>&1 || true
        if [ -n "${2:-}" ] && systemctl is-active --quiet "${UNIT_NAME}" 2>/dev/null; then
            systemctl try-restart "${UNIT_NAME}" >/dev/null 2>&1 || true
        else
            systemctl restart "${UNIT_NAME}" >/dev/null 2>&1 || true
        fi

        # Configuration completed: the next install/upgrade/reinstall must ask again.
        rm -f "${MARKER}"
        ;;
    abort-upgrade)
        systemctl daemon-reload >/dev/null 2>&1 || true
        ;;
esac

exit 0
